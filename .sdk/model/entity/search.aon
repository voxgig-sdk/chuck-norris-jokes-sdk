# Entity: search

main: kit: entity: search: {

  alias: field: {}

  fields: [
    {
      name: "categories"
      req: false
      short: "Categories associated with the joke"
      type: "`$ARRAY`"
    }
    {
      name: "icon_url"
      req: true
      short: "URL to Chuck Norris avatar icon"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: true
      short: "Unique identifier for the joke"
      type: "`$STRING`"
    }
    {
      name: "url"
      req: true
      short: "Direct URL to the joke"
      type: "`$STRING`"
    }
    {
      name: "value"
      req: true
      short: "The actual Chuck Norris joke text"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "search"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: "roundhouse"
                kind: "query"
                name: "query"
                orig: "query"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/jokes/search"
          parts: [
            "jokes"
            "search"
          ]
          select: {
            exist: [
              "query"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.result`"
          }
        }
      ]
    }
  }



}
